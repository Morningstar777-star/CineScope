# CineScope Environment Configuration Template

# Groq Cloud Synthesis (Get a free key at https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FAST_MODEL=openai/gpt-oss-20b

# Search & Metadata Providers (DuckDuckGo works out of the box with 0 keys)
DEFAULT_SEARCH_PROVIDER=duckduckgo
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=
TMDB_API_KEY=

# Local LAYA Engine Settings (convaiinnovations/laya)
USE_LAYA_LOCAL=true
LAYA_MODEL_PATH=convaiinnovations/laya
DEVICE=cuda

# Application Server Settings
ENVIRONMENT=development
PORT=8000
FRONTEND_PORT=5173
CACHE_DB_PATH=backend/cinescope_cache.db
CACHE_TTL_HOURS=24
RATE_LIMIT_PER_MINUTE=60
